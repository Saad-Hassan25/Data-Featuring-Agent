# Copy to .env and fill in. The .env file is loaded automatically.

# Required for LLM-backed runs (get a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Any model on OpenRouter that returns JSON reliably. Examples:
#   anthropic/claude-sonnet-4
#   anthropic/claude-3.7-sonnet
#   google/gemini-2.5-pro
#   openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional: a cheaper model used only for the report stage.
# OPENROUTER_FALLBACK_MODEL=anthropic/claude-3.5-haiku

# Optional — defaults shown
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional — attribution shown on OpenRouter's dashboards
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_APP_NAME=feature-agent
